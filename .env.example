# Mobile app. On a physical phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.9:3000

# Backend only: never expose these in EXPO_PUBLIC_* variables.
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-shared-drive-folder-id
GOOGLE_OAUTH_CLIENT_FILE=./server/oauth-client.json
GOOGLE_OAUTH_REFRESH_TOKEN=
